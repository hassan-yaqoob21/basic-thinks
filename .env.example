# ---------------------------------------------------------------------------
# Basic Thinks — environment variables
#
# Every value is OPTIONAL. The site builds and runs with none of them set.
# On Vercel: add these under Project → Settings → Environment Variables.
# Never commit real secrets — .env* files are gitignored.
# ---------------------------------------------------------------------------

# Public site URL used for canonical / Open Graph metadata.
# Set this to the production domain once it is connected (e.g. basicthinks.com).
NEXT_PUBLIC_SITE_URL=

# Optional contact-form backend endpoint (read server-side only — the browser
# never sees this value). Any JSON POST endpoint works: Formspree, Web3Forms,
# Resend-based API route, your own backend, etc.
# When left unset, the contact form honestly falls back to opening the
# visitor's email client with a prefilled message they must send themselves.
CONTACT_FORM_ENDPOINT=
